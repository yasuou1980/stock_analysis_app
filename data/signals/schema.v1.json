{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily public market signals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "signals"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{1,24}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "signals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticker",
          "strategy",
          "price_as_of",
          "close_usd",
          "signal",
          "rsi",
          "deviation",
          "score",
          "adx",
          "ret_5d"
        ],
        "properties": {
          "ticker": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.-]{0,11}$"
          },
          "strategy": {
            "enum": [
              "トレンドフォロー",
              "逆張り",
              "押し目候補"
            ]
          },
          "price_as_of": {
            "type": "string",
            "format": "date"
          },
          "close_usd": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,8})\\.[0-9]{6}$"
          },
          "signal": {
            "enum": [
              "BUY",
              "HOLD",
              "SELL"
            ]
          },
          "rsi": {
            "type": [
              "number",
              "null"
            ]
          },
          "deviation": {
            "type": [
              "number",
              "null"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "adx": {
            "type": [
              "number",
              "null"
            ]
          },
          "ret_5d": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
